BASSWIESN_MASTERLOG_ENABLED=1
# BASSWIESN_MASTERLOG_MAX_MB=50
# BASSWIESN_MASTERLOG_BACKUP_COUNT=5
# BASSWIESN_STATION_UPLOAD_MAX_MB=50
# BASSWIESN_STATION_UPLOAD_QUOTA_MB=500
# BASSWIESN_SUPPORT_BUNDLE_MAX_MB=50
BASSWIESN_VERSION=2.5.0
# Runtime defaults to the image's non-root user (UID/GID 10001). Rootless
# Docker installations may override this with a named image user or use the
# installer's ACL fallback for the bind mount.
# BASSWIESN_RUNTIME_USER=basswiesn
# Optional comma-separated radio IPs and device IDs that must never be
# contacted. Configure both identifiers when possible. The guard runs before
# HTTP, CLI, SSH, Telnet, discovery follow-up and background transports.
PROTECTED_DEVICE_IPS=
PROTECTED_DEVICE_IDS=

# Optional advanced settings:
# BASSWIESN_LAN_HOST=
# Optional comma-separated host-interface addresses. A fresh Docker install
# fills these two LAN values automatically; use this only to override them.
# BASSWIESN_LAN_HOST_CANDIDATES=
# BASSWIESN_LOCAL_BASE_URL=
# BASSWIESN_WEB_BASE_URL=
# BASSWIESN_DEBUG_BASE_URL=
# BASSWIESN_TEST_MODE=0
# Require a validated generated release manifest in healthcheck responses. Keep
# false for normal source development; release verification enables it.
# BASSWIESN_RELEASE_MANIFEST_REQUIRED=false
# BASSWIESN_DISABLE_SETUP_CONFIRMATIONS=0
# BASSWIESN_SETUP_WRITE_RADIO_IPS=
# Alternative prefixed names for the same server-side hard blocks.
# Applies to Telnet, SSH, presets, multiroom, setup redirects, LAB and batch
# actions. The same additional IP list can be edited in the WebGUI options.
# BASSWIESN_PROTECTED_DEVICE_IPS=
# BASSWIESN_PROTECTED_DEVICE_IDS=
# BASSWIESN_PLAYBACK_KEEPALIVE_ENABLED=true
# BASSWIESN_PLAYBACK_KEEPALIVE_INTERVAL_SECONDS=300
# BASSWIESN_PLAYBACK_KEEPALIVE_LOG_EVERY_SECONDS=1800
# BASSWIESN_PLAYBACK_STATE_STALE_AFTER_SECONDS=360
# Portable-specific Safe Mode is disabled in 2.5.0; all devices use the same
# shared backoff, circuit breaker and interaction-locking rules.
# BASSWIESN_PORTABLE_SAFE_LOW_RISK_INTERVAL_SECONDS=3600
# BASSWIESN_STATIONARY_LOW_RISK_INTERVAL_SECONDS=300
# Discovery defaults. SSDP is preferred; IP scan remains a bounded fallback.
# BASSWIESN_SSDP_ENABLED=true
# BASSWIESN_SSDP_TIMEOUT_SECONDS=4
# BASSWIESN_SSDP_INTERVAL_SECONDS=300
# BASSWIESN_IP_SCAN_FALLBACK=true
# Device interaction coordinator.
# BASSWIESN_DEVICE_INTERACTION_MAX_CONCURRENCY=4
# Events and interaction retention.
# BASSWIESN_EVENT_RETENTION_DAYS=30
# BASSWIESN_INTERACTION_RETENTION_DAYS=14
# BASSWIESN_RETENTION_DAYS=30
# BASSWIESN_REQUEST_LOG_RETENTION_DAYS=14
# BASSWIESN_TELEMETRY_RETENTION_DAYS=30
# BASSWIESN_CONFIG_BACKUP_RETENTION_COUNT=100
# Offline Mode: off, auto, strict. Strict blocks optional external services.
# BASSWIESN_OFFLINE_MODE=auto
# Comma-separated hostnames allowed as stream targets in Strict Offline Mode.
# BASSWIESN_OFFLINE_ALLOWED_STREAM_HOSTS=
# Webhooks are disabled by default and require explicit safe target hosts.
# BASSWIESN_WEBHOOKS_ENABLED=false
# BASSWIESN_WEBHOOK_ALLOWED_HOSTS=
# BASSWIESN_WEBHOOK_TIMEOUT_SECONDS=5
# BASSWIESN_WEBHOOK_MAX_RETRIES=5
# Telnet device control is disabled by default. It never exposes a shell or a
# free command input; supported actions use fixed model/firmware profiles only.
# BASSWIESN_TELNET_ENABLED=false
# BASSWIESN_TELNET_PORT=23
# BASSWIESN_TELNET_TIMEOUT_SECONDS=8
# BASSWIESN_TELNET_REBOOT_WAIT_SECONDS=180
# BASSWIESN_TELNET_USERNAME=
# BASSWIESN_TELNET_PASSWORD_FILE=
# BASSWIESN_TELNET_ALLOWED_DEVICE_IDS=
# SSH setup credentials are read from files or the local SSH agent only; the
# password value is never accepted through the Web API. The username is safe
# to configure here, while the secret paths stay local and untracked.
# BASSWIESN_SSH_USERNAME=
# BASSWIESN_SSH_PORT=22
# BASSWIESN_SSH_TIMEOUT_SECONDS=8
# BASSWIESN_SSH_RETRY_COUNT=2
# BASSWIESN_SSH_PASSWORD_FILE=
# BASSWIESN_SSH_PRIVATE_KEY_FILE=
# BASSWIESN_SSH_KNOWN_HOSTS_FILE=
# BASSWIESN_SSH_HOST_KEY_POLICY=strict
# Normal setup creates a private per-install token below data/setup-rebuild;
# users do not need to configure it. Advanced deployments may instead point
# to an existing readable secret file, which is never returned by API or logs.
# BASSWIESN_MARGE_AUTH_TOKEN_FILE=/app/secrets/setup-rebuild/marge_auth_token
# Standby-clock recovery is manual and disabled until enabled explicitly.
# BASSWIESN_STANDBY_CLOCK_RECOVERY_ENABLED=false
# Local media is experimental and disabled until roots are explicitly configured.
# BASSWIESN_MEDIA_ENABLED=false
# BASSWIESN_MEDIA_ROOTS=
# BASSWIESN_MEDIA_MAX_FILE_SIZE_MB=500
# Optional experimental/LAB areas. They do not start background services while disabled.
# BASSWIESN_EXPERIMENTAL_DLNA=false
# BASSWIESN_EXPERIMENTAL_ANNOUNCEMENTS=false
# BASSWIESN_LAB_MODE=false
# Backup/update/diagnostic limits.
# BASSWIESN_BACKUP_RETENTION_COUNT=10
# BASSWIESN_DIAGNOSTIC_MAX_SIZE_MB=50
# BASSWIESN_UPDATE_ALLOW_LOCAL_ARCHIVE=true
# Problem-radio maintenance is opt-in per device and globally safe by default.
# BASSWIESN_MAINTENANCE_REBOOT_ENABLED_BY_DEFAULT=false
# Legacy compatibility only: automatic radio reboots remain disabled in 2.5.0.
# BASSWIESN_MAINTENANCE_REBOOT_SCHEDULER_ENABLED=false
# BASSWIESN_MAINTENANCE_REBOOT_DEFAULT_INTERVAL_HOURS=24
# BASSWIESN_MAINTENANCE_REBOOT_MIN_INTERVAL_HOURS=6
# BASSWIESN_MAINTENANCE_REBOOT_MAX_INTERVAL_HOURS=168
# BASSWIESN_MAINTENANCE_REBOOT_RETURN_TIMEOUT_SECONDS=600
# BASSWIESN_MAINTENANCE_REBOOT_SCHEDULER_INTERVAL_SECONDS=300
# BASSWIESN_ENABLE_HTTPS=false
# BASSWIESN_HTTPS_PORT=1329
# BASSWIESN_CERT_MODE=selfsigned
# BASSWIESN_CERT_DAYS=3650
# BASSWIESN_TLS_CERT_FILE=
# BASSWIESN_TLS_KEY_FILE=
# BASSWIESN_UPDATE_CHECK_ENABLED=false
# BASSWIESN_UPDATE_CHANNEL=manual
# BASSWIESN_UPDATE_MANIFEST_URL=
# BASSWIESN_UPDATE_REPO_URL=
